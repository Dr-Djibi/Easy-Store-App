{
  "expo": {
    "name": "Menma Store App",
    "slug": "menma-store-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "menmastore",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#060501"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.menmastore.admin"
    },
    "android": {
      "package": "com.menmastore.admin",
      "adaptiveIcon": {
        "backgroundColor": "#060501"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application a besoin d'accéder à vos photos pour ajouter des visuels à vos produits."
        }
      ]
    ]
  }
}
