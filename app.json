{
  "expo": {
    "name": "EStore",
    "slug": "estore-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "estore",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#060501"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.estore.admin"
    },
    "android": {
      "package": "com.estore.admin",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#060501"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "EStore a besoin d'accéder à vos photos pour ajouter des visuels à vos produits."
        }
      ]
    ]
  }
}
