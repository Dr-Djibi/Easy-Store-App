{
  "expo": {
    "name": "Easyphy Admin",
    "slug": "easyphy-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "owner": "dr-djibi",
    "scheme": "easyphy",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#060501"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.easyphy.admin",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.easyphy.admin",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060501"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Easyphy a besoin d'accéder à vos photos pour ajouter des visuels à vos produits."
        }
      ],
      "expo-asset"
    ]
  }
}
